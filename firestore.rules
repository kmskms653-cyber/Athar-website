rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ */
    /* الصلاحيات — تُتحقق من جهة الخادم فقط                                */
    /* ------------------------------------------------------------------ */

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    /* موافقة سارية على النسخة الحالية من الشروط والخصوصية.
       عند تحديث الوثائق غيّر التاريخ هنا وفي src/atharConfig.js معاً. */
    function hasConsent() {
      return signedIn()
        && exists(/databases/$(database)/documents/consents/$(request.auth.uid))
        && get(/databases/$(database)/documents/consents/$(request.auth.uid)).data.termsVersion == '2026-11-25'
        && get(/databases/$(database)/documents/consents/$(request.auth.uid)).data.privacyVersion == '2026-11-25';
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // المدير العام: البريد المعتمد في ATHAR_CONFIG.superAdmins
    function isSuper() {
      return verified() && email() == 'atharstudio653@gmail.com';
    }

    function adminRef() {
      return /databases/$(database)/documents/admins/$(email());
    }

    function adminData() {
      return get(adminRef()).data;
    }

    // المدير المساعد: موجود في مجموعة admins بدور sub
    function isSub() {
      return verified()
        && exists(adminRef())
        && adminData().role == 'sub';
    }

    function isAdmin() {
      return isSuper() || isSub();
    }

    // التحقق من سعر الباقة
    function bundlePrice(bundleId) {
      return bundleId == 'starter-bundle' ? 129 :
        bundleId == 'ads-bundle' ? 189 :
        bundleId == 'reels-bundle' ? 229 :
        bundleId == 'athar-complete-bundle' ? 379 : 0;
    }

    // التحقق من مسار الإيصال
    function validReceiptPath(path) {
      return path is string
        && path.size() <= 300
        && (
          path == ''
          || path.matches('receipts/' + request.auth.uid + '/.*')
        );
    }

    // الحقول المسموح بها في الطلبات
    function orderKeys() {
      return [
        'uid',
        'email',
        'name',
        'bundleId',
        'title',
        'price',
        'currency',
        'paymentMethod',
        'senderName',
        'receiptPath',
        'receiptFileName',
        'receiptDriveId',
        'receiptDriveUrl',
        'receiptMime',
        'receiptSize',
        'receiptDeletedAt',
        'status',
        'createdAt'
      ];
    }

    /* ------------------------------------------------------------------ */
    /* محتوى الموقع والخدمات (قراءة عامة للزوار)                          */
    /* ------------------------------------------------------------------ */

    match /site/{docId} {
      allow read: if true;

      // المدير العام يكتب كل المحتوى (النصوص، الأيقونات، الأسعار)
      allow create, delete: if isSuper();

      // المدير المساعد يعدّل الخدمات فقط (إضافة/إخفاء/نصوص) دون الأيقونات أو بقية المحتوى
      allow update: if isSuper()
        || (
          isSub()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['services'])
          && request.resource.data.services.size() <= 12
        );
    }

    /* ------------------------------------------------------------------ */
    /* القوالب (قراءة عامة، كتابة بحسب الدور)                             */
    /* ------------------------------------------------------------------ */

    match /templates/{templateId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isSuper();
    }

    /* ------------------------------------------------------------------ */
    /* المديرون المساعدون (حد أقصى يُدار من الواجهة)                       */
    /* ------------------------------------------------------------------ */

    match /admins/{emailId} {
      // كل مستخدم يقرأ سجله فقط (لمعرفة دوره)، والمدير العام يقرأ الجميع
      allow get: if isSuper() || (verified() && email() == emailId);
      allow list: if isSuper();

      allow create, update: if isSuper()
        && request.resource.data.email == emailId
        && request.resource.data.role == 'sub'
        && emailId != 'atharstudio653@gmail.com';

      allow delete: if isSuper();
    }

    /* ------------------------------------------------------------------ */
    /* سجل الموافقات القانونية                                            */
    /* ------------------------------------------------------------------ */

    match /consents/{uid}/log/{entry} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == email()
        && request.resource.data.acceptedAt is timestamp;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if false;
    }

    match /consents/{uid} {
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == email()
        && request.resource.data.termsVersion is string
        && request.resource.data.termsVersion.size() <= 20
        && request.resource.data.privacyVersion is string
        && request.resource.data.privacyVersion.size() <= 20
        && request.resource.data.acceptedAt is timestamp;

      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // لا حذف لسجلات الموافقة إلا من المدير العام (ولا يُنصح به)
      allow delete: if isSuper();
    }

    /* ------------------------------------------------------------------ */
    /* مشاريع صانع الهوية                                                 */
    /* ------------------------------------------------------------------ */

    match /creativeProjects/{projectId} {
      allow read, update, delete: if signedIn()
        && resource.data.uid == request.auth.uid;

      allow create: if hasConsent()
        && request.resource.data.uid == request.auth.uid
        && projectId.size() > request.auth.uid.size()
        && projectId.matches(request.auth.uid + '_.*')
        && request.resource.data.mode in ['identity', 'personal', 'corporate', 'signature', 'mark']
        && request.resource.data.ink is string
        && request.resource.data.ink.size() <= 9
        && request.resource.data.paper is string
        && request.resource.data.paper.size() <= 9;
    }

    /* ------------------------------------------------------------------ */
    /* طلبات شراء الباقات                                                 */
    /* ------------------------------------------------------------------ */

    match /orders/{orderId} {

      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
        );

      allow create: if hasConsent()
        && request.resource.data.keys().hasOnly(orderKeys())
        && request.resource.data.keys().hasAll([
          'uid',
          'bundleId',
          'price',
          'currency',
          'senderName',
          'receiptPath',
          'receiptFileName',
          'status',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bundleId in [
          'starter-bundle',
          'ads-bundle',
          'reels-bundle',
          'athar-complete-bundle'
        ]
        && orderId == request.auth.uid + '_'
          + request.resource.data.bundleId
        && request.resource.data.status == 'pending_review'
        && request.resource.data.currency == 'ر.س'
        && request.resource.data.price
          == bundlePrice(request.resource.data.bundleId)
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 100
        && validReceiptPath(request.resource.data.receiptPath)
        && request.resource.data.receiptFileName is string
        && request.resource.data.receiptFileName.size() <= 200
        && request.resource.data.receiptDriveId is string
        && request.resource.data.receiptDriveId.size() <= 120
        && request.resource.data.receiptDriveUrl is string
        && request.resource.data.receiptDriveUrl.size() <= 600
        && request.resource.data.receiptMime is string
        && request.resource.data.receiptMime.size() <= 100
        && request.resource.data.receiptSize is int
        && request.resource.data.receiptSize >= 0
        && request.resource.data.receiptSize <= 20971520
        && request.resource.data.receiptDeletedAt == null
        && request.resource.data.createdAt == request.time;

      // تعديل الطلب من الإدارة أو إعادة الإرسال بعد الرفض
      allow update: if isAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending_review'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.bundleId == resource.data.bundleId
          && request.resource.data.price == resource.data.price
          && request.resource.data.title == resource.data.title
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'senderName',
              'receiptPath',
              'receiptFileName',
              'receiptDriveId',
              'receiptDriveUrl',
              'receiptMime',
              'receiptSize',
              'receiptDeletedAt',
              'status'
            ])
          && validReceiptPath(request.resource.data.receiptPath)
        );

      allow delete: if isAdmin();
    }

    /* ------------------------------------------------------------------ */
    /* ملفات تسليم الباقات                                                */
    /* ------------------------------------------------------------------ */

    match /deliveries/{bundleId} {

      allow read: if isAdmin()
        || (
          request.auth != null
          && exists(
            /databases/$(database)/documents/orders/$(request.auth.uid + '_' + bundleId)
          )
          && get(
            /databases/$(database)/documents/orders/$(request.auth.uid + '_' + bundleId)
          ).data.status == 'completed'
        );

      allow write: if isAdmin();
    }

    /* ------------------------------------------------------------------ */
    /* طلبات التواصل والخدمات                                             */
    /* ------------------------------------------------------------------ */

    match /requests/{requestId} {

      allow create: if hasConsent()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'name',
          'contact',
          'service',
          'message',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'name',
          'contact',
          'message',
          'status',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0
        && request.resource.data.contact.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && (
          !request.resource.data.keys().hasAny(['service'])
          || (
            request.resource.data.get('service', '') is string
            && request.resource.data.get('service', '').size() <= 100
          )
        )
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }
  }
}
