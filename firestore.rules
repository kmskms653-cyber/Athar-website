
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // التحقق من المدير
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'kmskms653@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // تحديد أسعار الباقات المعتمدة
    function bundlePrice(bundleId) {
      return bundleId == 'starter-bundle' ? 129 :
        bundleId == 'ads-bundle' ? 189 :
        bundleId == 'reels-bundle' ? 229 :
        bundleId == 'athar-complete-bundle' ? 379 : -1;
    }

    // محتوى الموقع
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // الحقول المسموح بها في الطلبات
    function orderKeys() {
      return [
        'uid',
        'email',
        'name',
        'bundleId',
        'title',
        'price',
        'currency',
        'paymentMethod',
        'senderName',
        'receiptPath',
        'receiptFileName',
        'status',
        'createdAt'
      ];
    }

    // التحقق من مسار الإيصال
    function validReceiptPath(path) {
      return path is string
        && path.size() <= 300
        && (
          path == ''
          || path.matches('receipts/' + request.auth.uid + '/.*')
        );
    }

    // طلبات شراء الباقات
    match /orders/{orderId} {

      // قراءة الطلبات
      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
        );

      // إنشاء طلب جديد
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(orderKeys())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bundleId in [
          'starter-bundle',
          'ads-bundle',
          'reels-bundle',
          'athar-complete-bundle'
        ]
        && orderId == request.auth.uid + '_' + request.resource.data.bundleId
        && request.resource.data.status == 'pending_review'
        && request.resource.data.currency == 'ر.س'
        && request.resource.data.price == bundlePrice(request.resource.data.bundleId)
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 100
        && validReceiptPath(request.resource.data.receiptPath)
        && request.resource.data.receiptFileName is string
        && request.resource.data.receiptFileName.size() <= 200
        && request.resource.data.createdAt == request.time;

      // تحديث الطلب: المدير أو إعادة إرسال إيصال بعد الرفض
      allow update: if isAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending_review'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.bundleId == resource.data.bundleId
          && request.resource.data.price == resource.data.price
          && request.resource.data.title == resource.data.title
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'receiptPath',
                'receiptFileName',
                'senderName',
                'status'
              ])
          && request.resource.data.keys().hasOnly(orderKeys())
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 100
          && validReceiptPath(request.resource.data.receiptPath)
          && request.resource.data.receiptFileName is string
          && request.resource.data.receiptFileName.size() <= 200
        );

      // الحذف للمدير فقط
      allow delete: if isAdmin();
    }

    // ملفات تسليم الباقات
    match /deliveries/{bundleId} {

      // القراءة للمدير أو العميل الذي اكتمل طلبه
      allow read: if isAdmin()
        || (
          request.auth != null
          && exists(
            /databases/$(database)/documents/orders/$(request.auth.uid + '_' + bundleId)
          )
          && get(
            /databases/$(database)/documents/orders/$(request.auth.uid + '_' + bundleId)
          ).data.status == 'completed'
        );

      // الكتابة للمدير فقط
      allow write: if isAdmin();
    }

    // طلبات التواصل والاستفسارات
    match /requests/{requestId} {

      // استقبال طلبات الزوار
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'contact',
          'service',
          'message',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'contact',
          'message',
          'status',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0
        && request.resource.data.contact.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && (
          !request.resource.data.keys().hasAny(['service'])
          || (
            request.resource.data.service is string
            && request.resource.data.service.size() <= 100
          )
        )
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      // قراءة وتعديل وحذف الطلبات للمدير فقط
      allow read, update, delete: if isAdmin();
    }
  }
}
