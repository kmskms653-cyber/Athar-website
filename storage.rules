rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // إيصالات التحويل: العميل يرفع داخل مجلده فقط (صور/PDF حتى 10MB)، ويقرؤها هو والمدير
    match /receipts/{uid}/{file} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
      allow delete: if request.auth != null
        && request.auth.token.email == 'kmskms653@gmail.com' && request.auth.token.email_verified == true;
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || (request.auth.token.email == 'kmskms653@gmail.com' && request.auth.token.email_verified == true));
    }
  }
}
